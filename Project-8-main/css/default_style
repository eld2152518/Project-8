body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 100%;
    margin: 0;
}

#wrapper {
    background-color: #eeeeee;
    margin-top: 50px;
}

header {
    background: #2d3437 url("../images/background.jpg") no-repeat center;
    background-size: cover;
    color: white;
    margin: 0;
}

h1 {
    font-family: Georgia, "Times New Roman", Times, serif;
    text-align: center;
    padding-top: 75px;
    padding-bottom: 75px;
    margin: 0;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
}

nav ul {
    list-style-type: none;
    background-color: #2d3437;
    overflow: hidden;
    padding: 0;
    margin: 0;
}

nav li {
    float: left;
}

nav li.right {
    float: right;
    background-color: #135367;
}

nav a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 20px;
}

nav a:hover,
nav a.active {
    background-color: #135367;
    color: white;
}

main {
    width: 900px;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 20px;
}

aside {
    background-color: #cccccc;
    width: 30%;
    box-sizing: border-box;
    padding: 10px;
    margin: 10px;
    float: right;
}

aside img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    opacity: 60%;
}

aside img:hover {
    opacity: 100%;
}

aside p {
    margin: 0;
    color: #666666;
}

aside a {
    color: #135367;
}

footer {
    clear: both;
    background-color: #2d3437;
    color: white;
    padding: 20px;
    text-align: center;
}

footer a {
    color: white;
}